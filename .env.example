# AstraForce ortam değişkenleri
# `pnpm setup:all` bu dosyadan .env üretir (.env yoksa). .env git'e girmez.

# --- NASA FIRMS ---
# Ücretsiz anahtar: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# --- NASA Earthdata (Yanık Alan / Burned Area ürünleri için)
# Ücretsis kayıt: https://urs.earthdata.nasa.gov/
EARTHDATA_USER=
EARTHDATA_PASS=

# --- PostGIS (docker compose) ---
POSTGRES_USER=astra
POSTGRES_PASSWORD=astra_local_dev
POSTGRES_DB=astraforce
# 5432 yerine 5433: makinede yerel bir PostgreSQL kurulursa çakışmasın
POSTGRES_PORT=5433
DATABASE_URL=postgresql://astra:astra_local_dev@localhost:5433/astraforce

# --- API (FastAPI) ---
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Token gerektirmeyen ücretsiz vektör harita stili
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
